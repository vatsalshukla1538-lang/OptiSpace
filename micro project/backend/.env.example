# ==============================================================================
# OptiSpace Django Backend Environment Configuration
# ==============================================================================
#
# LOCAL DEVELOPMENT:
# - Leave DATABASE_URL commented out to automatically use local SQLite (db.sqlite3).
# - Set DEBUG=True.
#
# PRODUCTION / VERCEL DEPLOYMENT:
# - DATABASE_URL is REQUIRED on Vercel. SQLite will fail in Vercel's read-only
#   serverless environment. Connect to a managed PostgreSQL service (e.g. Neon, Supabase,
#   AWS RDS, Render Postgres).
# - Set DEBUG=False.
# - Set a strong, randomly-generated SECRET_KEY.
# - Set ALLOWED_HOSTS to include your Vercel domains (e.g. .vercel.app, your-custom-domain.com).
# ==============================================================================

# Database Connection String
# PostgreSQL format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Example for Neon/Supabase:
# DATABASE_URL=postgresql://neondb_owner:npg_xyz123@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Leave unset or empty for zero-config local SQLite:
# DATABASE_URL=

# Core Django Security
SECRET_KEY=replace-with-a-long-random-url-safe-secret-key-in-production
DEBUG=True

# Hostnames & Routing
# In production on Vercel: ALLOWED_HOSTS=.vercel.app,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection Behavior (especially for Serverless / Vercel)
# In serverless environments, DB_CONN_MAX_AGE=0 prevents holding dead connections.
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=True

# JWT Authentication Lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
